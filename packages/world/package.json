{
  "name": "@office/world",
  "version": "1.0.0",
  "private": true,
  "description": "Dunia bersama Office Agents (F2): tata letak Lantai 1, navigasi, dialog template, dan simulasi rutinitas agen ber-seed tanpa Three.js.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@office/shared": "*"
  }
}
