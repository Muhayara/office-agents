NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_KEY=sk-your-9router-key
OFFICE_PORT=7420
OFFICE_MCP_PORT=7421

# Token CEO (minimal 24 karakter). Kosongkan agar server membuat token acak
# di data/.office-token saat pertama kali jalan (folder data/ di-gitignore).
OFFICE_TOKEN=

# Opsional: token pengunjung (view-only), minimal 24 karakter, harus beda dari token CEO.
OFFICE_VIEWER_TOKEN=

# Opsional: host & origin tambahan yang diizinkan (dipisah koma), mis. nama Tailscale.
# OFFICE_ALLOWED_HOSTS=pc-kantor.tailnet-xyz.ts.net
# OFFICE_ALLOWED_ORIGINS=http://pc-kantor.tailnet-xyz.ts.net:5173

# Opsional: alamat bind server (default 127.0.0.1). Jangan ubah tanpa alasan kuat.
# OFFICE_BIND_HOST=127.0.0.1

# Opsional: tambahkan atribut Secure pada cookie sesi bila diakses lewat HTTPS.
# OFFICE_COOKIE_SECURE=1
