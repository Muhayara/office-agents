{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "jiro": {
      "type": "http",
      "url": "https://jiro.build/mcp"
    },
    "office": {
      "type": "http",
      "url": "http://127.0.0.1:7421/mcp",
      "headers": {
        "Authorization": "Bearer ${OFFICE_TOKEN:-}"
      }
    }
  }
}
